{
  "name": "Auth",
  "api_id": "auth",
  "org_id": "default",
  "active": true,
  "use_keyless": true,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "proxy": {
    "listen_path": "/api/auth/",
    "target_url": "http://user-service:8080/auth/",
    "strip_listen_path": true
  }
}
