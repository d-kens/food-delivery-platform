{
  "name": "User Service",
  "api_id": "user-service",
  "org_id": "default",
  "active": true,
  "use_keyless": true,
  "definition": {
    "location": "header",
    "key": "x-api-version"
  },
  "version_data": {
    "not_versioned": true,
    "versions": {
      "Default": {
        "name": "Default",
        "use_extended_paths": true
      }
    }
  },
  "custom_middleware": {
    "driver": "otto",
    "pre": [
      {
        "name": "cookieToBearer",
        "path": "/opt/tyk-gateway/middleware/cookieToBearer.js",
        "require_session": false
      }
    ]
  },
  "proxy": {
    "listen_path": "/api/user-service/",
    "target_url": "http://host.docker.internal:9001/",
    "strip_listen_path": true
  }
}
